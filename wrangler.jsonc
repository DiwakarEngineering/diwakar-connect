{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker / project name in the Cloudflare dashboard.
  "name": "diwakar-connect",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference used by OpenNext for caching; must match "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "diwakar-connect"
    }
  ],
  "observability": { "enabled": true },
  // All variables and secrets (Supabase, LiveKit) are set in the Cloudflare
  // dashboard (Worker -> Settings -> Variables and Secrets), never here.
  // Without this, every `wrangler deploy` deletes dashboard text variables.
  "keep_vars": true
}
