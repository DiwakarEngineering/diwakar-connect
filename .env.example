# Copy to .env.local and fill in. Never commit real values.

# --- Public (shipped to the browser) ---------------------------------------
# Supabase project URL and anon key: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Public URL of this app, used in auth email links (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server only (never prefix with NEXT_PUBLIC_) --------------------------
# Used only by /api/admin/* and /api/calls/* route handlers.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Audio/video calls (optional) ------------------------------------------
# Leave blank to run without calls: the app shows a "setup needed" state.
# LiveKit Cloud (https://cloud.livekit.io) or a self-hosted LiveKit server.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Staff import scripts only (scripts/lib/employees.mjs) -----------------
# Starting passwords given to imported accounts. Not used by the running app.
STAFF_PASSWORD=
ADMIN_PASSWORD=

# --- Logging ---------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info

# --- Staging tooling only (scripts/db-push.mjs, scripts/e2e-staging.mjs) ----
# Never set these for production. Both scripts refuse to run unless
# E2E_CONFIRM_PROJECT_REF matches the project in the URLs above.
# Dashboard -> Connect -> "Session pooler" connection string (includes the DB password).
SUPABASE_DB_URL=
# The <project-ref> part of NEXT_PUBLIC_SUPABASE_URL.
E2E_CONFIRM_PROJECT_REF=
# Optional: an inbox you control; the E2E test sends ONE real invitation email there.
E2E_INVITE_EMAIL=
# Optional: where the app is running (default http://localhost:3000).
E2E_APP_URL=
