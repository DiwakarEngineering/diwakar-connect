{
  "expo": {
    "name": "Diwakar Connect",
    "slug": "diwakar-connect",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "diwakarconnect",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.diwakarsolar.connect",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Diwakar Connect uses the camera for video calls and to send photos in chats.",
        "NSMicrophoneUsageDescription": "Diwakar Connect uses the microphone for calls and voice messages.",
        "NSPhotoLibraryUsageDescription": "Diwakar Connect lets you send photos and videos from your library in chats.",
        "UIBackgroundModes": ["audio", "voip"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.diwakarsolar.connect",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.WAKE_LOCK"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Diwakar Connect uses the microphone for calls and voice messages."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Diwakar Connect lets you send photos and videos from your library in chats.",
          "cameraPermission": "Diwakar Connect uses the camera for video calls and to send photos in chats."
        }
      ],
      ["@livekit/react-native-expo-plugin", { "android": { "audioType": "communication" } }],
      "@config-plugins/react-native-webrtc",
      ["expo-build-properties", { "android": { "minSdkVersion": 24 } }]
    ],
    "extra": {
      "supabaseUrl": "https://vnirohyvgppeikjgjiot.supabase.co",
      "supabaseAnonKey": "sb_publishable_rVUIKjRe1lFAMC6T0CFBuw_egUqBew1",
      "siteUrl": "https://diwakar-connect.engineering-aeb.workers.dev"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
